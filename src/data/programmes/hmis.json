{
  "code": "HMIS",
  "name": "HMIS Monthly Report",
  "shortName": "Monthly count",
  "icon": "chart",
  "colour": "due",
  "source": "HMIS standard monthly reporting format, sub-centre section (aggregate counts only)",
  "sourceUrl": "https://nhm.gov.in/",
  "version": 1,
  "note": "Aggregate only — this programme receives no name, no address and no identifier.",
  "fields": [
    {
      "id": "month",
      "label": "Reporting month",
      "from": "hmis.reportMonth",
      "required": true
    },
    {
      "id": "village",
      "label": "Sub-centre area",
      "from": "household.village",
      "required": true
    },
    {
      "id": "date",
      "label": "Date of service",
      "from": "visit.date",
      "required": true
    },
    {
      "id": "asha",
      "label": "Reported by (ASHA code)",
      "from": "visit.ashaId",
      "required": true
    },
    {
      "id": "ancNew",
      "label": "New ANC registrations",
      "from": "hmis.ancNewRegistrations",
      "required": true
    },
    {
      "id": "ancDone",
      "label": "ANC visits completed",
      "from": "anc.visitsDone",
      "required": true,
      "for": [
        "Pregnancy"
      ]
    },
    {
      "id": "tt",
      "label": "TT/Td doses given",
      "from": "hmis.ttDosesGiven",
      "required": true
    },
    {
      "id": "ifa",
      "label": "IFA tablets distributed",
      "from": "hmis.ifaDistributed",
      "required": true
    },
    {
      "id": "hrp",
      "label": "High-risk pregnancies found",
      "from": "hmis.hrpIdentified",
      "required": true
    },
    {
      "id": "anaemia",
      "label": "Anaemia cases (Hb band)",
      "from": "vitals.hb",
      "required": true,
      "for": [
        "Pregnancy",
        "Newborn",
        "Health check",
        "Illness"
      ]
    },
    {
      "id": "hrpFlag",
      "label": "HRP flag",
      "from": "pregnancy.isHighRisk",
      "required": true,
      "for": [
        "Pregnancy"
      ]
    },
    {
      "id": "tbPres",
      "label": "TB presumptive cases",
      "from": "tb.symptomatic",
      "required": true,
      "for": [
        "Health check",
        "Illness"
      ]
    }
  ]
}
