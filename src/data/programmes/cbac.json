{
  "code": "CBAC",
  "name": "NP-NCD Screening (CBAC)",
  "shortName": "NCD screening",
  "icon": "stethoscope",
  "colour": "agent",
  "source": "Community Based Assessment Checklist, revised 27 June 2018 — Part A risk score and Part B early detection of NCDs and tuberculosis",
  "sourceUrl": "https://qps.nhsrcindia.org/sites/default/files/2021-03/Revised%20Community%20Based%20Assessment%20Checklist%2027%20June%202018.pdf",
  "version": 2,
  "fields": [
    { "id": "name",     "label": "Name",                     "from": "person.name",         "required": true,
      "for": ["Pregnancy", "Health check", "Illness"] },
    { "id": "age",      "label": "Age",                      "from": "person.age",          "required": true,
      "for": ["Pregnancy", "Health check", "Illness"] },
    { "id": "sex",      "label": "Sex",                      "from": "person.sex",          "required": true,
      "for": ["Pregnancy", "Health check", "Illness"] },
    { "id": "village",  "label": "Village",                  "from": "household.village",   "required": true,
      "for": ["Pregnancy", "Health check", "Illness"] },
    { "id": "aadhaar",  "label": "Identifier (Aadhaar last 4)","from": "person.aadhaarLast4","required": false, "for": ["Health check"] },
    { "id": "mobile",   "label": "Telephone number",         "from": "person.mobile",       "required": true,  "for": ["Health check"] },
    { "id": "ayushman", "label": "Health insurance scheme",   "from": "household.ayushmanCard","required": false,"for": ["Health check"] },

    { "id": "age40",    "label": "A1 Age 40 or above",       "from": "ncd.age40plus",       "required": true,
      "for": ["Pregnancy", "Health check"] },
    { "id": "tobacco",  "label": "A2 Smoking or smokeless tobacco","from": "ncd.tobacco",   "required": true,
      "for": ["Pregnancy", "Health check"] },
    { "id": "alcohol",  "label": "A3 Daily alcohol",         "from": "ncd.alcohol",         "required": true,
      "for": ["Pregnancy", "Health check"] },
    { "id": "waist",    "label": "A4 Waist circumference (cm)","from": "ncd.waistCm",       "required": true,
      "for": ["Pregnancy", "Health check"] },
    { "id": "activity", "label": "A5 150 minutes activity a week","from": "ncd.physicalActivity","required": true,
      "for": ["Pregnancy", "Health check"] },
    { "id": "family",   "label": "A6 Family history of BP, diabetes or heart disease","from": "ncd.familyHistory","required": true,
      "for": ["Pregnancy", "Health check"] },
    { "id": "score",    "label": "Part A total score",       "from": "ncd.cbacScore",       "required": true,
      "for": ["Pregnancy", "Health check"] },
    { "id": "screen",   "label": "Score 4 or more — refer for screening","from": "ncd.screenRequired","required": true,
      "for": ["Pregnancy", "Health check"] },

    { "id": "bpSys",    "label": "BP systolic",              "from": "vitals.bpSys",        "required": true,
      "for": ["Pregnancy", "Health check"] },
    { "id": "bpDia",    "label": "BP diastolic",             "from": "vitals.bpDia",        "required": true,
      "for": ["Pregnancy", "Health check"] },
    { "id": "sugar",    "label": "Random blood sugar",       "from": "vitals.bloodSugar",   "required": false, "for": ["Health check"] },
    { "id": "bmi",      "label": "BMI",                      "from": "vitals.bmi",          "required": false, "for": ["Health check"] },
    { "id": "onRx",     "label": "Already on treatment",     "from": "ncd.onTreatment",     "required": true,  "for": ["Health check"] },

    { "id": "cough",    "label": "B1 Cough for more than 2 weeks","from": "tb.cough2weeks", "required": true,
      "for": ["Pregnancy", "Health check", "Illness"] },
    { "id": "tbSym",    "label": "B1 Other TB symptoms",     "from": "tb.symptoms",         "required": true,  "for": ["Health check"] },
    { "id": "tbRef",    "label": "Referred for sputum testing","from": "tb.referred",       "required": true,
      "for": ["Pregnancy", "Health check", "Illness"] },
    { "id": "oral",     "label": "B1 Oral cavity symptoms",  "from": "ncd.oralSymptoms",    "required": true,  "for": ["Health check"] },
    { "id": "oralSus",  "label": "Suspected oral lesion",    "from": "ncd.suspectedOral",   "required": true,  "for": ["Health check"] },
    { "id": "skin",     "label": "B1 Skin patch and sensation","from": "ncd.skinSymptoms",  "required": true,  "for": ["Health check"] },
    { "id": "lep",      "label": "Suspected leprosy",        "from": "ncd.suspectedLeprosy","required": true,  "for": ["Health check"] },
    { "id": "women",    "label": "B2 Breast and cervical symptoms","from": "ncd.womenSymptoms","required": true,"for": ["Health check"] },
    { "id": "womenSus", "label": "Suspected breast or cervical lesion","from": "ncd.suspectedBreastCervical","required": true,"for": ["Health check"] },
    { "id": "other",    "label": "B1 Other symptoms",        "from": "ncd.otherSymptoms",   "required": true,  "for": ["Health check"] },
    { "id": "mental",   "label": "Mental health follow-up",  "from": "ncd.mentalHealthFlag","required": true,  "for": ["Health check"] },
    { "id": "partB",    "label": "Any Part B symptom present","from": "ncd.partBPositive",  "required": true,  "for": ["Health check"] },
    { "id": "refTo",    "label": "Referred to",              "from": "referral.madeTo",     "required": true,  "for": ["Health check"] }
  ]
}
