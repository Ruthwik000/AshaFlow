# ==============================================================================
# AshaFlow Environment Configuration Example
# ==============================================================================

# Gemini AI (First choice for Chat and Assistant, and native Vision OCR)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash

# Groq / Grok AI (Ultra-fast Chat fallback, ~500 tps)
VITE_GROK_API_KEY=
VITE_GROK_MODEL=openai/gpt-oss-120b

# AI Proxy (Optional: set this if backend proxies AI requests)
VITE_AI_PROXY=
