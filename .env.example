# ==============================================================================
# AshaFlow Environment Configuration Example
# ==============================================================================

# Gemini AI (First choice for Chat and Assistant)
VITE_GEMINI_API_KEY=
VITE_GEMINI_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash

# Grok AI (Chat fallback and Vision OCR for paper register scanning)
VITE_GROK_API_KEY=
VITE_GROK_MODEL=grok-2-latest
VITE_GROK_VISION_MODEL=grok-2-vision-1212

# AI Proxy (Optional: set this if backend proxies AI requests)
VITE_AI_PROXY=
